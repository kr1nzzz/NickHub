{
  "manifest_version": 3,
  "name": "NickHub",
  "version": "0.6.6",
  "description": "Поиск свободных никнеймов и Idle Nickname Claim через магазин FACEIT.",
  "action": {
    "default_title": "Открыть NickHub",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.faceit.com/*"
  ],
  "permissions": [
    "scripting"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
